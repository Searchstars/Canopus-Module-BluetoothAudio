# Band 11 .139: native Supervisor loader has user-reported device success.
# These modules still use compile-only Rust audio/BT services; activation is unsupported.
RUST_TARGET_FEATURE=target-xiaomi-band-11-4-100-139
RUST_TARGET_TRIPLE=thumbv8m.main-none-eabi
RUST_TARGET_CPU=cortex-m33
MODULE_MAX_SIZE=0
CANOPUS_STATIC_CANDIDATE=1
