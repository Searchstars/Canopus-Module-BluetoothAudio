# Rust/private-ABI build selection for this exact firmware target.
RUST_TARGET_FEATURE=target-xiaomi-band-10-pro-3-101-030
RUST_TARGET_TRIPLE=thumbv8m.main-none-eabihf
RUST_TARGET_CPU=cortex-m33
# The hard-float target enables the exact SoC's FPv5 single-precision unit.
# No private firmware boundary passes floating-point arguments; eabihf is used
# so the resident MP3 decoder/resampler executes on hardware instead of the
# bluelet owner thread spending its entire budget in software f32 helpers.
# The stock modlib dynamically allocates SHF_ALLOC sections and has no observed
# fixed module-size ceiling. Zero disables the project-only loaded-size budget.
MODULE_MAX_SIZE=0
